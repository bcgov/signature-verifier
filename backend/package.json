{
  "author": "NRIDS",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "deploy": "npm ci --ignore-scripts --no-update-notifier && npm run build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "make-badges": "istanbul-badges-readme --logo=vitest --exitCode=1",
    "make-badges:ci": "npm run make-badges -- --ci",
    "test": "vitest --dir src",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest --dir test"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "express-prom-bundle": "^8.0.0",
    "helmet": "^8.0.0",
    "nest-winston": "^2.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.10.12",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "istanbul-badges-readme": "^1.9.0",
    "magicast": "^0.5.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "c12": ">=3.3.4 <4",
    "@hono/node-server": "<3",
    "js-yaml": "^5.2.2",
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.3",
    "multer": "^2.3.0"
  }
}
